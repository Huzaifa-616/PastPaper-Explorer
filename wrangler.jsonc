{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "pastpaperexplorer",
	"compatibility_date": "2026-05-24",
	"observability": {
		"enabled": true
	},
	"assets": {
		"directory": "./dist",
		"not_found_handling": "single-page-application",
		"binding": "ASSETS",
		"run_worker_first": [
			"/api/*"
		]
	},
	"compatibility_flags": [
		"nodejs_compat"
	]
}